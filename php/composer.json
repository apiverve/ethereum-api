{
    "name": "apiverve/ethereum",
    "description": "Ethereum Price is an Ethereum price feed API that tracks the spot price and movement direction of Ethereum in US dollars. Paid plans add 172 currencies, market cap, 24-hour volume, supply, all-time highs, 1-hour to 1-year changes, 30-day stats, and hourly and 30-day daily history.",
    "version": "1.2.5",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "ethereum",
        "ethereum price api",
        "ethereum api",
        "eth price api",
        "ethereum price feed api",
        "eth api"
    ],
    "homepage": "https://apiverve.com/marketplace/ethereum?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/ethereum",
        "source": "https://github.com/apiverve/ethereum-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Ethereum\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Ethereum\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
